// Social Media Team Scheduler — Database Schema
// Implements SOCIAL_SCHEDULER_SPEC.md §3 (source of truth).
//
// SQLite-specific adaptations (semantics preserved per §0 "adapt to schema"):
//   - Prisma enums are unsupported on SQLite → stored as String with the
//     spec's enum identifiers as values (e.g. status = "NOT_STARTED").
//   - Int[] is unsupported on SQLite → workDays stored as a JSON string,
//     e.g. "[6,0,1,2,3]". Parse with parseWorkDays() in lib/dates.ts.
// LOCAL schema (SQLite). Vercel uses prisma/schema.postgres.prisma instead
// (selected via --schema in the build command). KEEP THE MODELS BELOW IN SYNC
// with schema.postgres.prisma — only the datasource/generator blocks differ.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// EMPLOYEE  (§3)
// Enum mirrors (stored as String):
//   role: free text — مصمم / كاتب محتوى / ناشر / مصور / تيم ليدر
// ============================================
model Employee {
  id             String   @id @default(cuid())
  name           String
  role           String
  hoursPerDay    Float    @default(8)          // daily capacity in hours
  workDays       String   @default("[6,0,1,2,3]") // JSON Int[] getDay() values
  isScheduled    Boolean  @default(true)        // enters the auto content engine
  isPhotographer Boolean  @default(false)
  // Telegram handle WITHOUT the @ (e.g. "Omar_ORR"). The morning brief is
  // forwarded into the team group, where a real @mention is what actually gets
  // someone's attention. Null → the person is addressed by name, as the lead
  // does for anyone whose handle she doesn't use.
  telegramUsername String?
  // Numeric Telegram user id — the STABLE identity (a display name changes, an
  // id does not). When a delivery closes a piece, the credit goes to whoever
  // actually sent the file, matched through this. Without it the plan's owner
  // silently gets the credit: سابين's Jobs posts were booked to حلا.
  telegramUserId String?

  // أسماء العرض على تلغرام، مفصولة بفاصلة.
  // التصدير بيحمل الاسم الظاهر بس — بلا معرّف رقمي — والاسم الظاهر لاتيني عند
  // نص الفريق («Majed Abdullah» · «Elissar» · «Nawal St»)، فمطابقته بالعربي
  // بتفشل صامتة: ١٤٥ ملف لماجد و٢٥ لأليسار انرفضوا كـ«من غير المنتِجين».
  telegramAliases String?
  // Finance: monthly salary/cost (fixed). costPerReel = per-reel variable cost
  // for freelance photographers paid by the job (null = paid by salary).
  salary         Float    @default(0)
  costPerReel    Float?
  color          String?
  // Productivity rates (items per working day), JSON e.g. {"POST":6,"AI_REEL":1}.
  // Falls back to global defaults (lib/capacity.ts) per type when unset.
  rates          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Per-content-type ownership (§3)
  postCompanies   Company[] @relation("postOwner")
  storyCompanies  Company[] @relation("storyOwner")
  aiReelCompanies Company[] @relation("aiReelOwner")
  defaultCompanies Company[] @relation("defaultOwner")
  photographerCompanies Company[] @relation("photographer")
  accountCompanies      Company[] @relation("accountOwner")
  tasks           Task[]
}

// ============================================
// COMPANY  (§3)
// ============================================
model Company {
  id      String  @id @default(cuid())
  name    String  @unique
  managed Boolean @default(true)

  // Monthly plan (managed companies only)
  posts   Int @default(0)
  reels   Int @default(0)   // real reels → photographer
  stories Int @default(0)
  aiReels Int @default(0)   // AI reels → designer

  // Finance: monthly contract value (revenue) — used by the /finance P&L.
  contractValue Float @default(0)

  // Contract start date. When set, the company's monthly plan is distributed
  // over its 30-day CONTRACT CYCLE ([contractDay → contractDay next month])
  // instead of the calendar month. Null = distribute over the calendar month
  // (default / back-compatible behaviour).
  contractStartDate DateTime?

  // تاريخ **بدء النشر** — وهو مرساة الدورة، مو تاريخ توقيع العقد.
  // قرار القائدة (3/8/2026): «خلي تاريخ توقيع العقد شي وتاريخ النشر شي تاني…
  // والخطة شهر من تاريخ بدء النشر وليس توقيع العقد».
  // معظم الشركات بتبلّش النشر بعد التوقيع بأسبوع (أسبوع التحضير: الحسابات
  // واللوغو والخطة والتيمبليت). جدارات وSiizen العقد موقّع والنشر متأخر **من
  // الزبون** — فبيضل null، وبلاه:
  //   • ما في دورة شغّالة ولا شغل مجدول
  //   • ولا تأخير بينحسب علينا (هي «التأخيرات الوهمية» يلي وقعنا فيها)
  // أول ما يبلّش الزبون ينشر، بينحطّ التاريخ وبتمشي الدورات منه.
  publishStartDate DateTime?

  // حساب انستغرام (بلا @) — مرجع مطابقة النشر بالمحتوى.
  // القائدة سُئلت عن الحسابات مرتين لأنها ما كانت محفوظة بمكان؛ صارت تنحفظ
  // مرة وحدة وتنقرا من هون كل دورة جرد.
  instagramHandle String?

  // Contract RENEWAL history. A cycle no longer continues automatically: after
  // one ends, the next starts ONLY when a renewal is recorded, from the renewal
  // date (so a client renewed late leaves a real gap with no generated work).
  // JSON Int[]-style string of ISO dates for every cycle start AFTER the first,
  // e.g. "[\"2026-07-19\"]" (SQLite has no String[]). Parse with lib/contract.ts.
  renewals String?
  // Set when the answer to "is it renewed?" was NO — a hard stop: no cycle may
  // begin on/after this date. Cleared if the client later renews.
  contractEndedAt DateTime?

  // Preferred shoot weekday (getDay 0=Sun..6=Sat) for this company's reels — a
  // SOFT preference: the photographer snaps to it when possible, but it's not
  // mandatory and any shoot can be edited manually. Null = no preference.
  preferredShootDay Int?

  // Content plan is supplied externally (client/trainer) — the writer's plan
  // cards (كتابة) are skipped for this company.
  contentSupplied Boolean @default(false)

  // Why this company's work must NOT be counted as late — set when the delay is
  // the CLIENT's, not the team's (جدارات: the page access never arrived, so
  // nothing can be published and the team is not the one holding it up).
  // Non-null → its cards never appear in any «متأخر» list. Clear it the day the
  // blocker lifts; the real deadlines underneath were never touched.
  lateExemptReason String?

  // === Telegram follow-up (§14) ===
  // Latin short name used to build the canonical asset name «Agalia 7-1»
  // (= "<slug> <month>-<pieceNo>") that the team writes on every delivered
  // file. Null → derived from the company name at read time.
  slug String?
  // This company's Telegram group. Discovered automatically the first time the
  // bot sees a message there, then linked from /admin/telegram.
  telegramChatId String?
  // Content this company publishes that is NOT part of the paid plan — for
  // وصل, the client's own exchange-rate bulletins and economic analysis. It
  // goes out on the same channels and lands in the same group, but it must
  // never be credited to a plan piece or the achievement figures lie.
  // JSON array of keywords matched against a delivery's file name/caption.
  offPlanKeywords String?

  // Carried-over UI / deterministic-ordering fields (not part of §3 plan but
  // used by screens and to give the engine a stable company order).
  color    String? @default("#C8A84E")
  priority Int     @default(99)
  status   String  @default("active") // 'active' | 'paused' | 'archived'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-type owners + design-only default owner (§3 / §4.9)
  postOwnerId   String?
  postOwner     Employee? @relation("postOwner", fields: [postOwnerId], references: [id], onDelete: SetNull)
  storyOwnerId  String?
  storyOwner    Employee? @relation("storyOwner", fields: [storyOwnerId], references: [id], onDelete: SetNull)
  aiReelOwnerId String?
  aiReelOwner   Employee? @relation("aiReelOwner", fields: [aiReelOwnerId], references: [id], onDelete: SetNull)
  defaultOwnerId String?
  defaultOwner   Employee? @relation("defaultOwner", fields: [defaultOwnerId], references: [id], onDelete: SetNull)
  // Which photographer shoots THIS company's reels. Null → the first/only
  // photographer. Lets reel work be split across multiple freelance photographers.
  photographerId String?
  photographer   Employee? @relation("photographer", fields: [photographerId], references: [id], onDelete: SetNull)
  // Who OWNS the client relationship — the salesperson who brought them in and
  // still talks to them (مايكل / سارة), or the lead herself for the agency's own
  // brands. Not a producer: this person never gets content cards, they are who
  // you chase for an appointment, an approval or a renewal.
  accountOwnerId String?
  accountOwner   Employee? @relation("accountOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)

  tasks         Task[]
  photoSessions PhotoSession[]
}

// ============================================
// TASK  (§3)
// Enum mirrors (stored as String):
//   kind:     CONTENT | ADHOC | PHOTOSHOOT | REPORT | CONTENT_WRITING
//   type:     POST | REEL | AI_REEL | STORY  (null for ADHOC/REPORT)
//   priority: NORMAL | IMPORTANT | URGENT
//   status:   NOT_STARTED | IN_PROGRESS | AWAITING_APPROVAL | READY | PUBLISHED
// ============================================
model Task {
  id          String    @id @default(cuid())
  kind        String    @default("CONTENT")
  type        String?
  title       String?
  hours       Float     @default(0)
  quantity    Int       @default(1)              // batch size (e.g. "6 بوست" = 6)
  // Stable per-cycle piece number (بوست-N / ستوري-N) assigned at generation —
  // a piece keeps its number for life even when the rest of its cycle is
  // archived, so a June-cycle ستوري-6 never shows up renumbered as ستوري-1.
  pieceNo     Int?
  priority    String    @default("NORMAL")
  status      String    @default("NOT_STARTED")
  publishDate DateTime?
  readyDate   DateTime?
  workDate    DateTime?
  // Manual daily override: the lead pinned this task to a specific day in the
  // "مهام اليوم" queue (بدّل). On that day it tops the person's queue; before it,
  // it's held out of the queue. Self-expires (ignored once the day passes).
  manualDay   DateTime?
  week        Int?      // 1..4
  overflow    Boolean   @default(false)
  month       Int                                 // 0..11
  year        Int
  isPinned    Boolean   @default(false)           // manual lock — no auto reschedule
  isAuto      Boolean   @default(false)           // generated by the engine
  // Pipeline / kanban (agile workflow)
  stage       String?                             // WRITE | DESIGN | SHOOT | PUBLISH
  board       String    @default("TODO")          // TODO | DOING | REVIEW | DONE
  blockedById String?                             // predecessor stage-task (soft gate)
  pipelineKey String?                             // groups stages of one content item
  // Deterministic match key: companyId|type|YYYY-MM-DD(publishDate)|seq (§3)
  detKey      String?
  notes       String?
  // What this piece actually has to SAY — the hook, script and caption lifted
  // from the month's content plan (§14). The designer/photographer shouldn't
  // have to open a Word file to know what they are producing.
  brief       String?
  completedAt DateTime?
  startedAt   DateTime?                            // when work began (→ IN_PROGRESS)
  // مراجعة قائدة الفريق — مرحلة إلزامية بالعرض، **بس مو حاجزة**: القائدة بتراجع
  // كل شي عالمجموعة وبتبعت ملاحظاتها، وعمر بيقدر ينشر بلا ما يستناها (قرارها
  // 2/8/2026: «الزامية أي… بس ما تحطها شرط حصري»).
  // محطوطة كحقلين على صف القطعة بدل مرحلة مستقلة — مرحلة بتعني 386 صف جديد
  // لشخص واحد بلا سقف طاقة، وهاد بالضبط تكاثر الكروت يلي عم نتخلص منه.
  reviewedAt   DateTime?
  reviewedById String?
  finishedAt  DateTime?                            // when work finished (→ READY/PUBLISHED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([year, month])
  @@index([assigneeId])
  @@index([companyId])
  @@index([status])
  @@index([detKey])
}

// ============================================
// PHOTO SESSION  (§3, §4.6, §5.5)
// Enum mirrors (stored as String):
//   kind:   PHOTOSHOOT | REELS
//   status: NOT_STARTED | SHOT | EDITING | DELIVERED
// ============================================
model PhotoSession {
  id        String   @id @default(cuid())
  no        Int                              // session order per client (1 = photoshoot)
  kind      String   @default("REELS")
  shootDate DateTime
  deliverBy DateTime
  reelCount Int      @default(0)             // 0 for photoshoot, 2..3 for reels
  status    String   @default("NOT_STARTED")
  month     Int
  year      Int
  isAuto    Boolean  @default(true)
  detKey    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([year, month])
  @@index([companyId])
  @@index([detKey])
}

// ============================================
// SETTING — editable app config (§3)
// ============================================
model Setting {
  key       String   @id
  value     String                            // JSON
  updatedAt DateTime @updatedAt
}

// ============================================
// TELEGRAM (§14) — daily follow-up feed
//
// The team already runs one Telegram group per company: plans, designs and
// reels are all delivered there. The bot watches those groups so the dashboard
// knows what ACTUALLY went out each day, and builds the morning brief.
//
// No foreign keys on purpose: these rows are an external-system mirror, they
// must survive a company being renamed/re-created and the local→prod snapshot
// import, and nothing in the scheduling engine depends on them.
// ============================================

/// A Telegram conversation the bot has seen, linked to a company.
///
/// The team runs ONE forum supergroup («Desgin only (Team)») where each company
/// is a TOPIC, not a separate group — so the unit of linking is the topic, not
/// the chat. `id` is therefore composite: "<chatId>" for a plain group/private
/// chat, "<chatId>#<threadId>" for a forum topic.
model TelegramChat {
  id         String   @id
  chatId     String                           // Telegram chat id (groups are negative)
  threadId   Int?                             // forum topic id (null = plain chat / General)
  title      String?                          // topic name when known, else chat title
  type       String   @default("group")       // group | supergroup | channel | private
  companyId  String?                          // linked company (null = unlinked)
  isTeam     Boolean  @default(false)         // the General/team topic, not a client's
  lastText   String?                          // last message snippet — helps identify a topic
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([chatId])
}

/// One message seen in a watched chat — the "what actually got delivered" log.
model TelegramMessage {
  id           String   @id                   // "<chatId>:<messageId>" — idempotent ingest
  chatId       String                         // composite TelegramChat.id (may carry #thread)
  threadId     Int?
  messageId    Int
  sentAt       DateTime
  senderId     String?
  senderName   String?
  kind         String                         // PHOTO | VIDEO | DOCUMENT | AUDIO | TEXT
  fileName     String?
  caption      String?
  fileId       String?
  mediaGroupId String?                        // album → many messages, one piece
  companyId    String?                        // resolved from chatId at ingest
  // Auto-match result: which piece this delivery belongs to.
  taskId       String?
  matchedBy    String?                        // NAME | TYPE | MANUAL
  confirmed    Boolean  @default(false)        // the lead accepted the match
  createdAt    DateTime @default(now())

  @@index([chatId, sentAt])
  @@index([companyId, sentAt])
  @@index([taskId])
}
