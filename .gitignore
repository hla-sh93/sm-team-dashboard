node_modules/
.next/
out/
.env
.env.local
.env.*.local
# Catch-all: any *.env / *.env.local scratch file (a secret pasted into
# `telegram.env.local` slipped past the patterns above once — never again).
*.env
*.env.local
*.db
*.db-journal
.DS_Store
*.log

# Build artefacts
tsconfig.tsbuildinfo
next-env.d.ts

.claude/worktrees/
.claude/settings.local.json

.vercel

# Local scratch (dev-server pids, one-off scripts)
tmp/
.generated/

# Local DB snapshot IS tracked on purpose: the Vercel build imports it into
# production Postgres (IMPORT_LOCAL_SNAPSHOT=1, hash-guarded so it runs once per
# unique export). Re-sync prod = `npm run db:export-local` then commit + push.
#
# The dated safety copies taken before each risky data change are NOT: they are
# multi-megabyte SQLite binaries that only matter on this machine. `*.db` above
# misses them because they carry a suffix (dev.db.before-…).
backups/dev.db.*
backups/local-db-snapshot.*.json
backups/baseline-task-counts.json

# سكربتات استعلام مؤقتة أثناء الجلسة — مو جزء من المشروع
scripts/_tmp-*.ts
backups/pre-*.json
backups/dev-*.db
.tmp/
