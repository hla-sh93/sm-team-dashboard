// PRODUCTION schema (Postgres) — used by Vercel via --schema in the build
// command. Models are IDENTICAL to prisma/schema.prisma; only the datasource
// and generator differ. KEEP THE TWO IN SYNC when changing models.
generator client {
  provider      = "prisma-client-js"
  // "native" for local; rhel target is what the Vercel runtime needs.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id             String   @id @default(cuid())
  name           String
  role           String
  hoursPerDay    Float    @default(8)
  workDays       String   @default("[6,0,1,2,3]")
  isScheduled    Boolean  @default(true)
  isPhotographer Boolean  @default(false)
  telegramUsername String?
  telegramUserId String?
  salary         Float    @default(0)
  costPerReel    Float?
  color          String?
  rates          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  postCompanies    Company[] @relation("postOwner")
  storyCompanies   Company[] @relation("storyOwner")
  aiReelCompanies  Company[] @relation("aiReelOwner")
  defaultCompanies Company[] @relation("defaultOwner")
  photographerCompanies Company[] @relation("photographer")
  accountCompanies      Company[] @relation("accountOwner")
  tasks            Task[]
}

model Company {
  id      String  @id @default(cuid())
  name    String  @unique
  managed Boolean @default(true)

  posts   Int @default(0)
  reels   Int @default(0)
  stories Int @default(0)
  aiReels Int @default(0)

  contractValue Float @default(0)

  // Contract start date. When set, the company's monthly plan is distributed
  // over its 30-day CONTRACT CYCLE ([contractDay → contractDay next month])
  // instead of the calendar month. Null = calendar-month (default).
  contractStartDate DateTime?

  // تاريخ **بدء النشر** — وهو مرساة الدورة، مو تاريخ توقيع العقد.
  // قرار القائدة (3/8/2026): «خلي تاريخ توقيع العقد شي وتاريخ النشر شي تاني…
  // والخطة شهر من تاريخ بدء النشر وليس توقيع العقد».
  // معظم الشركات بتبلّش النشر بعد التوقيع بأسبوع (أسبوع التحضير: الحسابات
  // واللوغو والخطة والتيمبليت). جدارات وSiizen العقد موقّع والنشر متأخر **من
  // الزبون** — فبيضل null، وبلاه:
  //   • ما في دورة شغّالة ولا شغل مجدول
  //   • ولا تأخير بينحسب علينا (هي «التأخيرات الوهمية» يلي وقعنا فيها)
  // أول ما يبلّش الزبون ينشر، بينحطّ التاريخ وبتمشي الدورات منه.
  publishStartDate DateTime?
  // Contract RENEWAL history — cycles do NOT continue automatically. JSON array
  // of ISO dates for every cycle start AFTER the first, e.g. "[\"2026-07-19\"]".
  // Kept as a JSON string (not String[]) to mirror the SQLite schema exactly.
  renewals String?
  // "Not renewed" answer — a hard stop; no cycle may begin on/after this date.
  contractEndedAt DateTime?
  // Soft preferred shoot weekday (getDay 0..6) for reels; null = none.
  preferredShootDay Int?

  // Content plan is supplied externally (client/trainer) — the writer's plan
  // cards (كتابة) are skipped for this company.
  contentSupplied Boolean @default(false)
  lateExemptReason String?

  // === Telegram follow-up (§14) — keep in sync with schema.prisma ===
  slug            String?
  telegramChatId  String?
  offPlanKeywords String?

  color    String? @default("#C8A84E")
  priority Int     @default(99)
  status   String  @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postOwnerId    String?
  postOwner      Employee? @relation("postOwner", fields: [postOwnerId], references: [id], onDelete: SetNull)
  storyOwnerId   String?
  storyOwner     Employee? @relation("storyOwner", fields: [storyOwnerId], references: [id], onDelete: SetNull)
  aiReelOwnerId  String?
  aiReelOwner    Employee? @relation("aiReelOwner", fields: [aiReelOwnerId], references: [id], onDelete: SetNull)
  defaultOwnerId String?
  defaultOwner   Employee? @relation("defaultOwner", fields: [defaultOwnerId], references: [id], onDelete: SetNull)
  photographerId String?
  photographer   Employee? @relation("photographer", fields: [photographerId], references: [id], onDelete: SetNull)
  accountOwnerId String?
  accountOwner   Employee? @relation("accountOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)

  tasks         Task[]
  photoSessions PhotoSession[]
}

model Task {
  id          String    @id @default(cuid())
  kind        String    @default("CONTENT")
  type        String?
  title       String?
  hours       Float     @default(0)
  quantity    Int       @default(1)
  pieceNo     Int?
  priority    String    @default("NORMAL")
  status      String    @default("NOT_STARTED")
  publishDate DateTime?
  readyDate   DateTime?
  workDate    DateTime?
  manualDay   DateTime?
  week        Int?
  overflow    Boolean   @default(false)
  month       Int
  year        Int
  isPinned    Boolean   @default(false)
  isAuto      Boolean   @default(false)
  stage       String?
  board       String    @default("TODO")
  blockedById String?
  pipelineKey String?
  detKey      String?
  notes       String?
  // Content brief lifted from the month's plan (§14) — keep in sync.
  brief       String?
  completedAt DateTime?
  startedAt   DateTime?
  // مراجعة قائدة الفريق — مرحلة إلزامية بالعرض، **بس مو حاجزة**: القائدة بتراجع
  // كل شي عالمجموعة وبتبعت ملاحظاتها، وعمر بيقدر ينشر بلا ما يستناها (قرارها
  // 2/8/2026: «الزامية أي… بس ما تحطها شرط حصري»).
  // محطوطة كحقلين على صف القطعة بدل مرحلة مستقلة — مرحلة بتعني 386 صف جديد
  // لشخص واحد بلا سقف طاقة، وهاد بالضبط تكاثر الكروت يلي عم نتخلص منه.
  reviewedAt   DateTime?
  reviewedById String?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([year, month])
  @@index([assigneeId])
  @@index([companyId])
  @@index([status])
  @@index([detKey])
}

model PhotoSession {
  id        String   @id @default(cuid())
  no        Int
  kind      String   @default("REELS")
  shootDate DateTime
  deliverBy DateTime
  reelCount Int      @default(0)
  status    String   @default("NOT_STARTED")
  month     Int
  year      Int
  isAuto    Boolean  @default(true)
  detKey    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([year, month])
  @@index([companyId])
  @@index([detKey])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================
// TELEGRAM (§14) — keep in sync with schema.prisma
// ============================================
model TelegramChat {
  id         String   @id
  chatId     String
  threadId   Int?
  title      String?
  type       String   @default("group")
  companyId  String?
  isTeam     Boolean  @default(false)
  lastText   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([chatId])
}

model TelegramMessage {
  id           String   @id
  chatId       String
  threadId     Int?
  messageId    Int
  sentAt       DateTime
  senderId     String?
  senderName   String?
  kind         String
  fileName     String?
  caption      String?
  fileId       String?
  mediaGroupId String?
  companyId    String?
  taskId       String?
  matchedBy    String?
  confirmed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([chatId, sentAt])
  @@index([companyId, sentAt])
  @@index([taskId])
}
