{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily-brief?wave=general",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/cron/daily-brief?wave=detail",
      "schedule": "0 5 * * *"
