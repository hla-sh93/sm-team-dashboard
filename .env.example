# ============================================================
# LOCAL DEVELOPMENT (default) — SQLite
# ------------------------------------------------------------
# The local Prisma schema (prisma/schema.prisma) uses the sqlite provider.
# `npm run setup` / `npm run db:push` / `npm run db:seed` all target this file.
DATABASE_URL="file:./dev.db"

# ============================================================
# PRODUCTION — Postgres (Vercel Postgres / Neon / Supabase)
# ------------------------------------------------------------
# Used by the build command via prisma/schema.postgres.prisma. On Vercel this is
# set automatically when you connect a Postgres database; to run the Postgres
# path locally, comment out the SQLite line above and uncomment this one:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ============================================================
# ADMIN AUTH (optional — has safe defaults)
# ------------------------------------------------------------
# The /admin area is password-protected. By default NO env vars are needed:
# the first visit to /admin lets the owner CREATE the password, and both the
# password (hashed) and the session-signing secret are stored in the DB.
#
# These env vars OVERRIDE the DB values when set (useful on managed hosts):
#   ADMIN_PASSWORD  — the admin password (plain; compared server-side only).
#   AUTH_SECRET     — 32+ byte random string used to sign session cookies.
# ADMIN_PASSWORD="change-me"
# AUTH_SECRET="run: openssl rand -hex 32"
